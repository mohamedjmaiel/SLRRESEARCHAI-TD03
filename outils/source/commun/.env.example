# Nécessaire uniquement pour le mode « LLM réel ». Le mode démonstration
# fonctionne sans clé et sans réseau.
# Sélectionnez exactement un fournisseur : groq ou ollama.
LLM_PROVIDER=groq

# Groq : clé personnelle requise. Ne publiez jamais le fichier .env réel.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ollama : utilisé uniquement si LLM_PROVIDER=ollama.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Facultatif : adresse transmise à OpenAlex (accès prioritaire « polite pool »).
OPENALEX_MAILTO=
